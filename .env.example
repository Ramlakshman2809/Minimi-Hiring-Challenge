# Required
ANTHROPIC_API_KEY=        # https://console.anthropic.com/settings/keys
TAVILY_API_KEY=           # https://app.tavily.com (free tier is enough)

# Optional
MODEL=claude-sonnet-5-5   # try claude-haiku-5-5 for lower latency, claude-opus-5-5 for harder research
PORT=3000
HOST=127.0.0.1
DEFAULT_TZ=               # IANA zone used when the browser doesn't send one, e.g. Asia/Kolkata (default: system zone)
LEDGER_PATH=data/ledger.jsonl
NOW_OVERRIDE=             # ISO timestamp to freeze the clock for demos/tests, e.g. 2026-11-11T16:22:00Z
